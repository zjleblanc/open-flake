DATABASE_URL=postgresql+asyncpg://openflake:openflake@localhost:5432/openflake
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
BASE_URL=http://localhost:8000
ATTACHMENTS_PATH=./data/attachments
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# HTTPS examples (Podman SSL override or local dev with `npm run dev:https`):
# BASE_URL=https://localhost
# CORS_ORIGINS=https://localhost,https://localhost:5173,http://localhost:8080,http://localhost:5173
# TRUSTED_PROXIES=*
#
# Direct backend HTTPS (optional; same filenames as nginx when using OPENFLAKE_SSL_DIR):
# OPENFLAKE_SSL_CERT=fullchain.pem
# OPENFLAKE_SSL_KEY=privkey.pem
