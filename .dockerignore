.git
.gitignore
**/.ansible
**/.venv
**/.env
**/.env.*
**/node_modules
**/dist
**/__pycache__
**/.pytest_cache
**/.DS_Store
**/.cursor
**/.vscode
**/.github
**/*.md
data/
docs/
scripts/
deploy/certs/*
!deploy/certs/.gitkeep
!scripts/ensure-postgres.sh
!scripts/start-backend.sh
!scripts/stop-backend.sh
