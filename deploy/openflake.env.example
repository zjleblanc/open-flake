# Optional install/upgrade settings — copy next to podman-install.sh or podman-upgrade.sh
# as openflake.env (same directory as the script you run). Sourced before CLI flags.
#
# Example: cp deploy/openflake.env.example ~/.local/share/openflake/openflake.env

OPENFLAKE_DOMAIN=itsm.example.com
OPENFLAKE_HTTPS_PORT=8443
OPENFLAKE_SSL_DIR=/etc/ssl/openflake
OPENFLAKE_SSL_CERT=fullchain.pem
OPENFLAKE_SSL_KEY=privkey.pem
# OPENFLAKE_ATTACHMENTS_DIR=/var/lib/openflake/attachments
# OPENFLAKE_IMAGE_TAG=latest
# OPENFLAKE_REGISTRY=quay.io/zleblanc
# OPENFLAKE_INSTALL_DIR=~/.local/share/openflake
# OPENFLAKE_ENABLE_SYSTEMD=1
# SECRET_KEY=
# POSTGRES_PASSWORD=openflake
# ADMIN_PASSWORD=admin
