FROM docker.io/library/python:3.12-slim AS builder

WORKDIR /build
COPY backend/ ./backend/
WORKDIR /build/backend
RUN pip install --no-cache-dir --prefix=/install .

FROM docker.io/library/python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends gosu && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --create-home --uid 1001 openflake
WORKDIR /app

COPY --from=builder /install /usr/local
# Lab seed (backend/app/seed/) is excluded via .dockerignore — not shipped in production.
COPY backend/app ./app
COPY backend/pyproject.toml .
COPY deploy/backend-entrypoint.sh /app/entrypoint.sh
COPY deploy/backend-healthcheck.sh /app/backend-healthcheck.sh
COPY deploy/ssl-readability-hint.sh /app/ssl-readability-hint.sh

RUN mkdir -p /data/attachments /etc/openflake/certs /run/openflake && \
    chmod +x /app/entrypoint.sh /app/backend-healthcheck.sh && \
    chown -R openflake:openflake /data /etc/openflake /run/openflake

USER root

ENV PYTHONUNBUFFERED=1
ENV ATTACHMENTS_PATH=/data/attachments

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.sh"]
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=15s \
    CMD ["/app/backend-healthcheck.sh"]
