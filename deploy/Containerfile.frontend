# Build static assets on the host platform so esbuild does not run under QEMU
# when publishing multi-arch images from Apple Silicon or other cross-build hosts.
FROM --platform=$BUILDPLATFORM docker.io/library/node:22-alpine AS builder

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM docker.io/library/nginx:1.27-alpine

COPY deploy/nginx.http.conf /etc/nginx/templates/http.conf
COPY deploy/nginx.http-redirect.conf /etc/nginx/templates/http-redirect.conf
COPY deploy/nginx.ssl.conf /etc/nginx/templates/ssl.conf
COPY deploy/nginx-entrypoint.sh /docker-entrypoint.d/40-openflake-ssl.sh
COPY deploy/ssl-readability-hint.sh /docker-entrypoint.d/ssl-readability-hint.sh
RUN chmod +x /docker-entrypoint.d/40-openflake-ssl.sh
COPY --from=builder /build/dist /usr/share/nginx/html

RUN mkdir -p /etc/nginx/certs && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

EXPOSE 8080 443
CMD ["nginx", "-g", "daemon off;"]
