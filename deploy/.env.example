# OpenFlake registry deployment — copy to .env and customize.
# Used with: podman compose -f podman-compose.registry.yaml [--env-file .env]

# Container registry and release tag
OPENFLAKE_REGISTRY=quay.io/zjleblanc
OPENFLAKE_IMAGE_TAG=latest

# Public hostname (used by install script to derive BASE_URL and CORS_ORIGINS)
OPENFLAKE_DOMAIN=localhost

# TLS certificate directory on the host (must contain fullchain.pem and privkey.pem)
OPENFLAKE_CERT_DIR=/etc/ssl/openflake

# Backend URL and CORS (install script sets these from OPENFLAKE_DOMAIN when using HTTPS)
OPENFLAKE_BASE_URL=https://localhost
OPENFLAKE_CORS_ORIGINS=https://localhost,https://localhost:5173,http://localhost:8080,http://localhost:5173

# Secrets — change before production
SECRET_KEY=change-me-in-production
POSTGRES_PASSWORD=openflake
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Reverse proxy support (default trusts all proxies in container networks)
TRUSTED_PROXIES=*
